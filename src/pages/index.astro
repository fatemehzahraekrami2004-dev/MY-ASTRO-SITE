---
// پیدا کردن تمام فایل‌های داستان در پوشه stories
const stories = await Astro.glob('./stories/*.md');
---

<html lang="fa" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <title> سایت داستان‌های من</title>
  </head>
  <body style="font-family: 'Segoe UI', Tahoma, sans-serif; background-color: #1e293b; color: #f1f5f9; margin: 0; padding: 0;">
    <header style="background-color: #0f172a; padding: 20px; text-align: center;">
      <h1 style="margin: 0; color: #38bdf8;">داستان‌های من 📚</h1>
      <p style="color: #94a3b8;">مجموعه داستان‌های کوتاه و روایت‌ها</p>
    </header>

    <main style="max-width: 800px; margin: 40px auto; padding: 0 20px;">
      <h2>آخرین داستان‌ها:</h2>
      <ul style="list-style: none; padding: 0;">
        {/* چرخیدن روی داستان‌ها و ساختن لینک برای آن‌ها */}
        {stories.map((story) => (
          <li style="background: #334155; margin-bottom: 15px; padding: 20px; border-radius: 8px; transition: 0.2s;">
            <a href={story.url} style="color: white; text-decoration: none; font-size: 1.2rem; font-weight: bold;">
              {story.frontmatter.title}
            </a>
            <p style="color: #94a3b8; font-size: 0.9rem; margin: 5px 0 0 0;">تاریخ: {story.frontmatter.date}</p>
          </li>
        ))}
      </ul>
    </main>
  </body>
</html>